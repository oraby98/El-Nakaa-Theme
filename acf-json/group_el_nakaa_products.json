{
    "key": "group_el_nakaa_products",
    "title": "El Nakaa Products",
    "fields": [
        {
            "key": "field_products_section_title",
            "label": "Section Title",
            "name": "section_title",
            "type": "text",
            "default_value": "منتجات بيور المميزة"
        },
        {
            "key": "field_products_count",
            "label": "Number of Products",
            "name": "products_count",
            "type": "number",
            "default_value": 8
        },
        {
            "key": "field_products_template",
            "label": "Template Style",
            "name": "template",
            "type": "select",
            "choices": {
                "1": "Template 1",
                "2": "Template 2"
            },
            "default_value": "1"
        },
        {
            "key": "field_product_tabs",
            "label": "Product Tabs",
            "name": "product_tabs",
            "type": "repeater",
            "layout": "table",
            "button_label": "Add Tab",
            "sub_fields": [
                {
                    "key": "field_tab_label",
                    "label": "Tab Label",
                    "name": "tab_label",
                    "type": "text",
                    "required": 1
                },
                {
                    "key": "field_tab_category",
                    "label": "Category",
                    "name": "tab_category",
                    "type": "taxonomy",
                    "taxonomy": "product_cat",
                    "field_type": "select",
                    "return_format": "id",
                    "allow_null": 1,
                    "add_term": 0,
                    "save_terms": 0,
                    "load_terms": 0,
                    "multiple": 0
                }
            ]
        },
        {
            "key": "field_products_show_view_more",
            "label": "Show View More Button",
            "name": "show_view_more",
            "type": "true_false",
            "default_value": 1,
            "ui": 1
        },
        {
            "key": "field_products_view_more_text",
            "label": "View More Button Text",
            "name": "view_more_text",
            "type": "text",
            "default_value": "مشاهده المزيد",
            "conditional_logic": [
                [
                    {
                        "field": "field_products_show_view_more",
                        "operator": "==",
                        "value": "1"
                    }
                ]
            ]
        },
        {
            "key": "field_products_view_more_url",
            "label": "View More Button URL",
            "name": "view_more_url",
            "type": "url",
            "instructions": "Leave blank to link automatically to the Shop page.",
            "conditional_logic": [
                [
                    {
                        "field": "field_products_show_view_more",
                        "operator": "==",
                        "value": "1"
                    }
                ]
            ]
        }
    ],
    "location": [
        [
            {
                "param": "block",
                "operator": "==",
                "value": "acf/el-nakaa-products"
            }
        ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "hide_on_screen": "",
    "active": true,
    "description": "",
    "show_in_rest": 0
}
